# SpectreScan Configuration Template
# Copy to .env and fill in your values

# Proxy Settings
PROXY_HTTP=
PROXY_HTTPS=
PROXY_SOCKS5=

# CVE Database
CVE_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# API Keys for Service Detection
SHODAN_API_KEY=
CENSYS_API_KEY=

# Scan Defaults
DEFAULT_SCAN_TYPE=auto
DEFAULT_TIMEOUT=1.0
DEFAULT_CONCURRENCY=500

# Logging
LOG_LEVEL=INFO
LOG_FILE=
